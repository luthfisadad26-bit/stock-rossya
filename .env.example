# ============================================================
# Rossya Busana - Environment Variables
# ============================================================
# Salin file ini menjadi .env.local dan isi dengan credential
# dari dashboard Supabase Anda (Settings > API).
#
# JANGAN commit file .env.local ke git!
# ============================================================

# Supabase Project URL
# Contoh: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon (Public) Key
# Digunakan di sisi client/browser. Aman untuk di-expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (RAHASIA — hanya untuk server-side)
# JANGAN pernah expose key ini di client/browser!
# Digunakan untuk operasi admin seperti seed data atau bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
